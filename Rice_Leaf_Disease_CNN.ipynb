    "class ReLU(Layer):\n",
    "    def forward(self, x):\n",
    "        mask = x > 0\n",
    "        if self.training: self._cache = mask\n",
    "        return x * mask\n",
    "\n",
    "    def backward(self, dout):\n",
    "        mask, self._cache = self._cache, None\n",
    "        return dout * mask\n",
    "\n",
    "\n",
    "class MaxPool2D(Layer):\n",
    "    \"\"\"Non-overlapping max pooling; odd trailing rows/cols are dropped (floor mode).\"\"\"\n",
    "    def __init__(self, size=2):\n",
    "        super().__init__(); self.p = size\n",
    "\n",
    "    def output_shape(self, s): return (s[0], s[1] // self.p, s[2] // self.p)\n",
    "\n",
    "    def forward(self, x):\n",
    "        n, c, h, w = x.shape; p = self.p; ho, wo = h // p, w // p\n",
    "        win = x[:, :, :ho * p, :wo * p].reshape(n, c, ho, p, wo, p).transpose(0, 1, 2, 4, 3, 5).reshape(n, c, ho, wo, p * p)\n",
    "        idx = win.argmax(axis=-1)\n",
    "        if self.training: self._cache = (x.shape, idx)\n",
    "        return np.take_along_axis(win, idx[..., None], axis=-1)[..., 0]\n",
    "\n",
    "    def backward(self, dout):\n",
    "        (n, c, h, w), idx = self._cache; p = self.p; ho, wo = h // p, w // p\n",
    "        dwin = np.zeros((n, c, ho, wo, p * p), dtype=dout.dtype)\n",
    "        np.put_along_axis(dwin, idx[..., None], dout[..., None], axis=-1)\n",
    "        dx = np.zeros((n, c, h, w), dtype=dout.dtype)\n",
    "        dx[:, :, :ho * p, :wo * p] = dwin.reshape(n, c, ho, wo, p, p).transpose(0, 1, 2, 4, 3, 5).reshape(n, c, ho * p, wo * p)\n",
    "        self._cache = None\n",
    "        return dx\n",
    "\n",
    "    def __repr__(self): return f\"MaxPool2D({self.p})\"\n",
    "\n",
    "\n",
    "class GlobalAvgPool2D(Layer):\n",
    "    def output_shape(self, s): return (s[0],)\n",
    "\n",
    "    def forward(self, x):\n",
    "        if self.training: self._cache = x.shape\n",
    "        return x.mean(axis=(2, 3))\n",
    "\n",
    "    def backward(self, dout):\n",
    "        n, c, h, w = self._cache; self._cache = None\n",
    "        return np.broadcast_to((dout / (h * w))[:, :, None, None], (n, c, h, w)).copy()\n",
    "\n",
    "\n",
    "class Dropout(Layer):\n",
    "    def __init__(self, p=0.5, rng=None):\n",
    "        super().__init__(); self.p = p; self.rng = rng or np.random.default_rng()\n",
    "\n",
    "    def forward(self, x):\n",
    "        if not self.training or self.p == 0.0:\n",
    "            return x\n",
    "        self._cache = (self.rng.random(x.shape) >= self.p).astype(x.dtype) / (1.0 - self.p)\n",
    "        return x * self._cache\n",
    "\n",
    "    def backward(self, dout):\n",
    "        if self._cache is None: return dout\n",
    "        mask, self._cache = self._cache, None\n",
    "        return dout * mask\n",
    "\n",
    "    def __repr__(self): return f\"Dropout(p={self.p})\"\n",
    "\n",
    "\n",
    "class Dense(Layer):\n",
    "    def __init__(self, n_in, n_out, rng=None):\n",
    "        super().__init__()\n",
    "        rng = rng or np.random.default_rng()\n",
    "        self.n_in, self.n_out = n_in, n_out\n",
    "        limit = np.sqrt(6.0 / (n_in + n_out))                          # Glorot uniform\n",
    "        self.params[\"W\"] = rng.uniform(-limit, limit, (n_in, n_out)).astype(np.float32)\n",
    "        self.params[\"b\"] = np.zeros(n_out, dtype=np.float32)\n",
    "\n",
    "    def no_decay(self): return {\"b\"}\n",
    "    def output_shape(self, s): return (self.n_out,)\n",
    "\n",
    "    def forward(self, x):\n",
    "        if self.training: self._cache = x\n",
    "        return x @ self.params[\"W\"] + self.params[\"b\"]\n",
    "\n",
    "    def backward(self, dout):\n",
    "        x, self._cache = self._cache, None\n",
    "        self.grads[\"W\"], self.grads[\"b\"] = x.T @ dout, dout.sum(axis=0)\n",
    "        return None if self.skip_input_grad else dout @ self.params[\"W\"].T\n",
    "\n",
    "    def __repr__(self): return f\"Dense({self.n_in}->{self.n_out})\""
   ]
