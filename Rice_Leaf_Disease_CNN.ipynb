    "class Layer:\n",
    "    \"\"\"Base class: parameters in `params`, matching gradients in `grads`.\"\"\"\n",
    "    def __init__(self):\n",
    "        self.params, self.grads = {}, {}\n",
    "        self.training = True\n",
    "        self.skip_input_grad = False     # the first layer never needs dL/d(image)\n",
    "        self._cache = None\n",
    "\n",
    "    def buffers(self):  return {}        # non-trainable state to save (BN running stats)\n",
    "    def no_decay(self): return set()     # params exempt from weight decay\n",
    "    def num_params(self): return int(sum(p.size for p in self.params.values()))\n",
    "    def output_shape(self, s): return s\n",
    "    def __repr__(self): return f\"{type(self).__name__}()\"\n",
    "\n",
    "\n",
    "class Conv2D(Layer):\n",
    "    def __init__(self, c_in, c_out, k=3, stride=1, padding=\"same\", bias=True, rng=None):\n",
    "        super().__init__()\n",
    "        rng = rng or np.random.default_rng()\n",
    "        self.c_in, self.c_out, self.k, self.stride = c_in, c_out, k, stride\n",
    "        self.pad = k // 2 if padding == \"same\" else int(padding)\n",
    "        self.params[\"W\"] = (rng.standard_normal((c_out, c_in, k, k)) * np.sqrt(2.0 / (c_in * k * k))).astype(np.float32)\n",
    "        self.use_bias = bias\n",
    "        if bias:\n",
    "            self.params[\"b\"] = np.zeros(c_out, dtype=np.float32)\n",
    "\n",
    "    def no_decay(self): return {\"b\"}\n",
    "\n",
    "    def output_shape(self, s):\n",
    "        c, h, w = s\n",
    "        return (self.c_out, conv_output_size(h, self.k, self.stride, self.pad), conv_output_size(w, self.k, self.stride, self.pad))\n",
    "\n",
    "    def forward(self, x):\n",
    "        n = x.shape[0]\n",
    "        cols, ho, wo = im2col(x, self.k, self.k, self.stride, self.pad)\n",
    "        out = cols @ self.params[\"W\"].reshape(self.c_out, -1).T          # (N*Ho*Wo, F)\n",
    "        if self.use_bias:\n",
    "            out += self.params[\"b\"]\n",
    "        if self.training:\n",
    "            self._cache = (x.shape, cols)\n",
    "        return out.reshape(n, ho, wo, self.c_out).transpose(0, 3, 1, 2)\n",
    "\n",
    "    def backward(self, dout):\n",
    "        x_shape, cols = self._cache\n",
    "        d = dout.transpose(0, 2, 3, 1).reshape(-1, self.c_out)          # dY_mat\n",
    "        self.grads[\"W\"] = (d.T @ cols).reshape(self.params[\"W\"].shape)  # dY^T X_col\n",
    "        if self.use_bias:\n",
    "            self.grads[\"b\"] = d.sum(axis=0)\n",
    "        self._cache = None\n",
    "        if self.skip_input_grad:\n",
    "            return None\n",
    "        return col2im(d @ self.params[\"W\"].reshape(self.c_out, -1), x_shape, self.k, self.k, self.stride, self.pad)\n",
    "\n",
    "    def __repr__(self):\n",
    "        return f\"Conv2D({self.c_in}->{self.c_out}, k={self.k}, s={self.stride}, p={self.pad})\""
   ]
