    "def save_checkpoint(path, model, meta):\n",
    "    blob = np.frombuffer(json.dumps(meta).encode(\"utf-8\"), dtype=np.uint8)\n",
    "    np.savez_compressed(path, **model.state_dict(), __meta__=blob)\n",
    "\n",
    "\n",
    "def load_checkpoint(path):\n",
    "    with np.load(path, allow_pickle=False) as data:                   \n",
    "        meta = json.loads(data[\"__meta__\"].tobytes().decode(\"utf-8\"))\n",
    "        state = {k: data[k] for k in data.files if k != \"__meta__\"}\n",
    "    m = build_rice_leaf_net(len(meta[\"class_names\"]), tuple(meta[\"channels\"]), meta[\"kernel_size\"], meta[\"dropout\"])\n",
    "    m.load_state_dict(state)\n",
    "    return m.eval(), meta\n",
    "\n",
    "\n",
    "def predict_image(source, model, meta, threshold=0.6, tta=True):\n",
    "    x = to_model_input(load_image(source, tuple(meta[\"image_size\"]))[None], meta[\"mean\"], meta[\"std\"])\n",
    "    p = predict_proba(model, x, tta=tta)[0]\n",
    "    i = int(p.argmax())\n",
    "    return dict(label=meta[\"class_names\"][i], confidence=float(p[i]), uncertain=bool(p[i] < threshold),\n",
    "                probabilities={n: round(float(v), 4) for n, v in zip(meta[\"class_names\"], p)})\n",
    "\n",
    "\n",
    "META = dict(class_names=CLASS_NAMES, image_size=list(IMAGE_SIZE), mean=MEAN.tolist(), std=STD.tolist(),\n",
    "            channels=list(CONFIG[\"channels\"]), kernel_size=CONFIG[\"kernel_size\"], dropout=CONFIG[\"dropout\"],\n",
    "            best_epoch=best_epoch, test_accuracy=test_m[\"accuracy\"], seed=CONFIG[\"seed\"])\n",
    "save_checkpoint(\"model.npz\", model, META)\n",
    "loaded_model, loaded_meta = load_checkpoint(\"model.npz\")\n",
    "print(f\"Saved rice_leaf_cnn.npz ({Path('model.npz').stat().st_size / 1024:.0f} KB) and reloaded it.\")\n",
    "\n",
    "# Predict a few TEST images (never seen in training) with the reloaded model\n",
    "demo = [te_idx[np.flatnonzero(labels[te_idx] == c)[0]] for c in range(K)] + [te_idx[np.flatnonzero(labels[te_idx] == 1)[1]]]\n",
    "fig, axes = plt.subplots(len(demo), 1, figsize=(9, 1.6 * len(demo)))\n",
    "for ax, j in zip(axes, demo):\n",
    "    r = predict_image(paths[j], loaded_model, loaded_meta)\n",
    "    ok = r[\"label\"] == CLASS_NAMES[labels[j]]\n",
    "    ax.imshow(Image.open(paths[j]).convert(\"RGB\").resize((660, 96))); ax.set_xticks([]); ax.set_yticks([]); ax.grid(False)\n",
    "    ax.set_title(f\"true: {CLASS_NAMES[labels[j]]}  |  predicted: {r['label']} ({r['confidence']:.0%})  {'✓' if ok else '✗'}\",\n",
    "                 loc=\"left\", fontsize=9, color=INK)\n",
    "plt.tight_layout(); plt.show()\n",
    "print(json.dumps(predict_image(paths[demo[0]], loaded_model, loaded_meta), indent=2))"
   ]
