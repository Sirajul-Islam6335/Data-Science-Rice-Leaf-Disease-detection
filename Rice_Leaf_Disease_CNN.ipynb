    "RNG = np.random.default_rng(0)\n",
    "\n",
    "def to64(layer):\n",
    "    for k in layer.params: layer.params[k] = layer.params[k].astype(np.float64)\n",
    "    if isinstance(layer, BatchNorm2D):\n",
    "        layer.running_mean, layer.running_var = layer.running_mean.astype(np.float64), layer.running_var.astype(np.float64)\n",
    "    return layer\n",
    "\n",
    "def rel_err(a, b):\n",
    "    return float(np.max(np.abs(a - b) / np.maximum(1e-8, np.abs(a) + np.abs(b))))\n",
    "\n",
    "def numeric_grad(f, x, h=1e-5):\n",
    "    g = np.zeros_like(x)\n",
    "    for i in np.ndindex(x.shape):\n",
    "        old = x[i]; x[i] = old + h; fp = f(); x[i] = old - h; fm = f(); x[i] = old\n",
    "        g[i] = (fp - fm) / (2 * h)\n",
    "    return g\n",
    "\n",
    "def check_layer(layer, x):\n",
    "    r = RNG.standard_normal(layer.forward(x).shape)\n",
    "    dx = layer.backward(r)\n",
    "    loss = lambda: float((layer.forward(x) * r).sum())\n",
    "    errs = {\"input\": rel_err(dx, numeric_grad(loss, x))}\n",
    "    for name, p in layer.params.items():\n",
    "        layer.forward(x); layer.backward(r)\n",
    "        errs[name] = rel_err(layer.grads[name].copy(), numeric_grad(loss, p))\n",
    "    return errs\n",
    "\n",
    "checks = {\n",
    "    \"Conv2D k3 s1 same\":  (to64(Conv2D(2, 3, 3, 1, \"same\", rng=RNG)), RNG.standard_normal((2, 2, 7, 6))),\n",
    "    \"Conv2D k3 s2 p1\":    (to64(Conv2D(2, 3, 3, 2, 1, rng=RNG)),      RNG.standard_normal((2, 2, 7, 6))),\n",
    "    \"BatchNorm2D\":        (to64(BatchNorm2D(3)),                       RNG.standard_normal((4, 3, 3, 3)) * 2 + 1),\n",
    "    \"ReLU\":               (ReLU(),                                     RNG.choice([-1.5, -0.5, 0.5, 1.5], (2, 3, 4, 4)) + RNG.uniform(-0.3, 0.3, (2, 3, 4, 4))),\n",
    "    \"MaxPool2D (odd size)\": (MaxPool2D(2),                             RNG.permutation(140).reshape(2, 2, 5, 7).astype(np.float64)),\n",
    "    \"GlobalAvgPool2D\":    (GlobalAvgPool2D(),                          RNG.standard_normal((2, 3, 4, 5))),\n",
    "    \"Dense\":              (to64(Dense(5, 4, rng=RNG)),                 RNG.standard_normal((3, 5))),\n",
    "}\n",
    "print(f\"{'layer':<22}{'max relative error':>20}   status\")\n",
    "for name, (layer, x) in checks.items():\n",
    "    worst = max(check_layer(layer, x).values())\n",
    "    print(f\"{name:<22}{worst:>20.2e}   {'PASS' if worst < 1e-6 else 'FAIL'}\")\n",
    "\n",
    "# softmax cross-entropy (with label smoothing)\n",
    "z, y = RNG.standard_normal((5, 3)), np.array([0, 2, 1, 1, 0])\n",
    "_, dz = softmax_cross_entropy(z, y, 0.1)\n",
    "e = rel_err(dz, numeric_grad(lambda: softmax_cross_entropy(z, y, 0.1)[0], z))\n",
    "print(f\"{'Softmax CE (eps=0.1)':<22}{e:>20.2e}   {'PASS' if e < 1e-6 else 'FAIL'}\")\n",
    "\n",
    "# the whole assembled network, end to end\n",
    "net = build_rice_leaf_net(3, channels=(4, 6), dropout=0.0, rng=np.random.default_rng(3))\n",
    "for l in net.layers: to64(l)\n",
    "xb, yb = RNG.standard_normal((3, 3, 8, 12)), np.array([0, 1, 2])\n",
    "_, d = softmax_cross_entropy(net(xb), yb); net.backward(d)\n",
    "e = max(rel_err(l.grads[n].copy(), numeric_grad(lambda: softmax_cross_entropy(net(xb), yb)[0], l.params[n]))\n",
    "        for l, n, _ in list(net.parameters()))\n",
    "print(f\"{'Full network':<22}{e:>20.2e}   {'PASS' if e < 1e-5 else 'FAIL'}\")\n",
    "\n",
    "# im2col convolution vs. a naive loop, and col2im as the exact adjoint of im2col\n",
    "conv = to64(Conv2D(3, 4, 3, padding=1, rng=RNG)); conv.params[\"b\"] = RNG.standard_normal(4)\n",
    "xc = RNG.standard_normal((2, 3, 5, 6)); xp = np.pad(xc, ((0, 0), (0, 0), (1, 1), (1, 1)))\n",
    "naive = np.array([[[[(xp[n, :, i:i+3, j:j+3] * conv.params[\"W\"][f]).sum() + conv.params[\"b\"][f]\n",
    "                     for j in range(6)] for i in range(5)] for f in range(4)] for n in range(2)])\n",
