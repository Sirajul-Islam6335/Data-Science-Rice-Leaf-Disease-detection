    "def stratified_kfold(labels, k, seed):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    folds = [[] for _ in range(k)]\n",
    "    for c in np.unique(labels):\n",
    "        for i, chunk in enumerate(np.array_split(rng.permutation(np.flatnonzero(labels == c)), k)):\n",
    "            folds[i] += chunk.tolist()\n",
    "    return [np.array(sorted(f), dtype=np.int64) for f in folds]\n",
    "\n",
    "\n",
    "if CONFIG[\"run_cv\"]:\n",
    "    k = CONFIG[\"cv_folds\"]\n",
    "    folds = stratified_kfold(labels, k, CONFIG[\"seed\"])\n",
    "    oof = np.zeros((len(labels), K))\n",
    "    val_frac = min(0.5, CONFIG[\"val_fraction\"] / (1 - 1 / k))\n",
    "    rows = []\n",
    "    print(f\"{'fold':>4} {'train':>6} {'val':>4} {'test':>5} {'best ep':>8} {'accuracy':>9} {'macro-F1':>9} {'log-loss':>9}\")\n",
    "    for i, te in enumerate(folds):\n",
    "        rest = np.setdiff1d(np.arange(len(labels)), te)\n",
    "        tr_rel, va_rel = stratified_split(labels[rest], [1 - val_frac, val_frac], CONFIG[\"seed\"] + i)\n",
    "        tr, va = rest[tr_rel], rest[va_rel]\n",
    "        m_i, mean_i, std_i, best_i, _ = fit(images[tr], labels[tr], images[va], labels[va], {**CONFIG, \"seed\": CONFIG[\"seed\"] + i}, verbose=False)\n",
    "        oof[te] = predict_proba(m_i, to_model_input(images[te], mean_i, std_i), tta=CONFIG[\"tta\"])\n",
    "        fm = evaluate_predictions(labels[te], oof[te], CLASS_NAMES)\n",
    "        rows.append(fm)\n",
    "        print(f\"{i + 1:>4} {len(tr):>6} {len(va):>4} {len(te):>5} {best_i:>8} {fm['accuracy']:>9.3f} {fm['macro_f1']:>9.3f} {fm['log_loss']:>9.3f}\")\n",
    "\n",
    "    acc, f1s = [r[\"accuracy\"] for r in rows], [r[\"macro_f1\"] for r in rows]\n",
    "    print(f\"\\nMean ± std over folds: accuracy {np.mean(acc):.3f} ± {np.std(acc, ddof=1):.3f} | macro-F1 {np.mean(f1s):.3f} ± {np.std(f1s, ddof=1):.3f}\")\n",
    "    pooled = evaluate_predictions(labels, oof, CLASS_NAMES)\n",
    "    kc = int(round(pooled[\"accuracy\"] * pooled[\"n\"])); lo, hi = wilson_interval(kc, pooled[\"n\"])\n",
    "    print(f\"Pooled out-of-fold: accuracy {pooled['accuracy']:.3f} ({kc}/{pooled['n']}), 95% CI [{lo:.2f}, {hi:.2f}]\\n\")\n",
    "    print(classification_report(pooled, CLASS_NAMES))\n",
    "    plot_confusion(pooled[\"confusion_matrix\"], f\"{k}-fold CV, out-of-fold (n={pooled['n']})\")"
   ]
  },
