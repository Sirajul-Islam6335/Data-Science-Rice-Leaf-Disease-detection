    "def load_image(source, size):\n",
    "    \"\"\"float32 RGB in [0, 1], shape (H, W, 3). Portrait images are rotated to landscape.\"\"\"\n",
    "    img = source if isinstance(source, Image.Image) else Image.open(source)\n",
    "    img = ImageOps.exif_transpose(img).convert(\"RGB\")\n",
    "    if img.height > img.width:\n",
    "        img = img.rotate(90, expand=True)\n",
    "    h, w = size\n",
    "    img = img.resize((w, h), Image.Resampling.BICUBIC)\n",
    "    return np.asarray(img, dtype=np.float32) / 255.0\n",
    "\n",
    "\n",
    "def stratified_split(labels, fractions, seed):\n",
    "    \"\"\"Split indices into len(fractions) groups with the same class balance; last group gets the rest.\"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    groups = [[] for _ in fractions]\n",
    "    for c in np.unique(labels):\n",
    "        idx = rng.permutation(np.flatnonzero(labels == c))\n",
    "        start = 0\n",
    "        for g, frac in enumerate(fractions[:-1]):\n",
    "            n = int(round(frac * len(idx)))\n",
    "            groups[g] += idx[start:start + n].tolist()\n",
    "            start += n\n",
    "        groups[-1] += idx[start:].tolist()\n",
    "    return [np.array(sorted(g), dtype=np.int64) for g in groups]\n",
    "\n",
    "\n",
    "def channel_stats(images):\n",
    "    return images.mean(axis=(0, 1, 2)).astype(np.float32), (images.std(axis=(0, 1, 2)) + 1e-6).astype(np.float32)\n",
    "\n",
    "\n",
    "def to_model_input(images, mean, std):\n",
    "    \"\"\"(N, H, W, 3) in [0,1] -> standardised, contiguous (N, 3, H, W).\"\"\"\n",
    "    x = (images - np.asarray(mean, np.float32)) / np.asarray(std, np.float32)\n",
    "    return np.ascontiguousarray(x.transpose(0, 3, 1, 2), dtype=np.float32)\n",
    "\n",
    "\n",
    "IMAGE_SIZE = (CONFIG[\"image_height\"], CONFIG[\"image_width\"])\n",
    "t0 = time.perf_counter()\n",
    "images = np.stack([load_image(p, IMAGE_SIZE) for p in paths]).astype(np.float32)\n",
    "print(f\"Loaded images: {images.shape} in {time.perf_counter() - t0:.1f}s\")\n",
    "\n",
    "train_frac = 1 - CONFIG[\"val_fraction\"] - CONFIG[\"test_fraction\"]\n",
    "tr_idx, va_idx, te_idx = stratified_split(labels, [train_frac, CONFIG[\"val_fraction\"], CONFIG[\"test_fraction\"]], CONFIG[\"seed\"])\n",
    "for name, idx in [(\"train\", tr_idx), (\"validation\", va_idx), (\"test\", te_idx)]:\n",
    "    print(f\"{name:<11} {len(idx):>3} images  per class: {np.bincount(labels[idx]).tolist()}\")\n",
    "assert not (set(tr_idx) & set(va_idx)) and not (set(tr_idx) & set(te_idx)) and not (set(va_idx) & set(te_idx))"
   ]
  },
