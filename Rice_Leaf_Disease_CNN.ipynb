    "def plot_confusion(cm, title):\n",
    "    from matplotlib.colors import LinearSegmentedColormap\n",
    "    cmap = LinearSegmentedColormap.from_list(\"blue\", [\"#ffffff\", \"#cde2fb\", \"#9ec5f4\", \"#6da7ec\", \"#3987e5\", \"#256abf\", \"#184f95\", \"#0d366b\"])\n",
    "    fig, ax = plt.subplots(figsize=(4.8, 4.2)); ax.grid(False)\n",
    "    ax.imshow(cm, cmap=cmap, vmin=0, vmax=max(1, cm.max()))\n",
    "    ax.set_xticks(range(K), CLASS_NAMES, rotation=20, ha=\"right\"); ax.set_yticks(range(K), CLASS_NAMES)\n",
    "    for i in range(K):\n",
    "        for j in range(K):\n",
    "            ax.text(j, i, str(cm[i, j]), ha=\"center\", va=\"center\", fontsize=11,\n",
    "                    color=\"#ffffff\" if cm[i, j] > 0.55 * cm.max() else INK, fontweight=\"bold\" if i == j else \"normal\")\n",
    "    ax.set_xlabel(\"predicted\"); ax.set_ylabel(\"true\"); ax.set_title(title, loc=\"left\", color=INK)\n",
    "    for s in ax.spines.values(): s.set_visible(False)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "def wilson_interval(k, n, z=1.96):\n",
    "    p = k / n; d = 1 + z * z / n; c = (p + z * z / (2 * n)) / d\n",
    "    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d\n",
    "    return c - h, c + h\n",
    "\n",
    "\n",
    "val_m = evaluate_predictions(labels[va_idx], predict_proba(model, to_model_input(images[va_idx], MEAN, STD), tta=CONFIG[\"tta\"]), CLASS_NAMES)\n",
    "test_probs = predict_proba(model, to_model_input(images[te_idx], MEAN, STD), tta=CONFIG[\"tta\"])\n",
    "test_m = evaluate_predictions(labels[te_idx], test_probs, CLASS_NAMES)\n",
    "k_correct = int(round(test_m[\"accuracy\"] * test_m[\"n\"]))\n",
    "lo, hi = wilson_interval(k_correct, test_m[\"n\"])\n",
    "\n",
    "print(f\"Validation accuracy (used for model selection): {val_m['accuracy']:.3f}\")\n",
    "print(f\"TEST accuracy: {test_m['accuracy']:.3f} ({k_correct}/{test_m['n']})  95% CI [{lo:.2f}, {hi:.2f}]  log-loss {test_m['log_loss']:.3f}\\n\")\n",
    "print(classification_report(test_m, CLASS_NAMES))\n",
    "plot_confusion(test_m[\"confusion_matrix\"], f\"Hold-out test set (n={test_m['n']})\")"
   ]
