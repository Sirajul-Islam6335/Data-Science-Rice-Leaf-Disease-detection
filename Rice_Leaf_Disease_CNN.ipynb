    "## 4. Data augmentation\n",
    "\n",
    "With only 84 training images, every epoch shows the network a **freshly perturbed** copy of each one. The network then has to learn features that survive these changes, instead of memorising pixels.\n",
    "\n",
    "| Transform | Range | Why it keeps the label |\n",
    "|---|---|---|\n",
    "| Random crop, then resize back | each side keeps 80–100 % | the disease does not depend on framing |\n",
    "| Horizontal & vertical flip | p = 0.5 each | a leaf has no canonical orientation |\n",
    "| Brightness | × U(0.85, 1.15) | lighting varies |\n",
    "| Contrast | $(x-\\bar x)\\,U(0.85,1.15)+\\bar x$ | exposure varies |\n",
    "| Saturation | $(x-\\text{gray})\\,U(0.85,1.15)+\\text{gray}$ | colour balance varies |\n",
    "\n",
    "**Hue is deliberately not changed**, because lesion colour (straw-yellow, brown, black) is diagnostic.\n",
    "\n",
    "Resizing uses **bilinear interpolation**. A target pixel that maps to source coordinates $(y,x)$, with $y_0=\\lfloor y\\rfloor,\\ \\alpha=y-y_0,\\ x_0=\\lfloor x\\rfloor,\\ \\beta=x-x_0$, gets\n",
    "\n",
    "$$I(y,x)=(1-\\alpha)(1-\\beta)I_{y_0,x_0}+(1-\\alpha)\\beta I_{y_0,x_0+1}+\\alpha(1-\\beta)I_{y_0+1,x_0}+\\alpha\\beta I_{y_0+1,x_0+1}.$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "9530fea6",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x340 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "_LUMA = np.array([0.299, 0.587, 0.114], dtype=np.float32)\n",
    "\n",
    "def bilinear_resize(img, out_h, out_w):\n",
    "    \"\"\"Bilinear resize of an (H, W, C) image (half-pixel-centre convention).\"\"\"\n",
    "    h, w = img.shape[:2]\n",
    "    if (h, w) == (out_h, out_w):\n",
    "        return img\n",
    "    ys = np.clip((np.arange(out_h) + 0.5) * h / out_h - 0.5, 0, h - 1)\n",
    "    xs = np.clip((np.arange(out_w) + 0.5) * w / out_w - 0.5, 0, w - 1)\n",
    "    y0, x0 = np.floor(ys).astype(int), np.floor(xs).astype(int)\n",
    "    y1, x1 = np.minimum(y0 + 1, h - 1), np.minimum(x0 + 1, w - 1)\n",
    "    wy, wx = (ys - y0)[:, None, None], (xs - x0)[None, :, None]\n",
    "    top = img[y0][:, x0] * (1 - wx) + img[y0][:, x1] * wx\n",
    "    bot = img[y1][:, x0] * (1 - wx) + img[y1][:, x1] * wx\n",
    "    return (top * (1 - wy) + bot * wy).astype(img.dtype)\n",
    "\n",
    "\n",
    "class Augmenter:\n",
    "    def __init__(self, cfg, rng):\n",
    "        self.c, self.rng = cfg, rng\n",
    "\n",
    "    def __call__(self, img):\n",
    "        c, r = self.c, self.rng\n",
    "        h, w = img.shape[:2]\n",
    "        if c[\"min_crop_scale\"] < 1.0:                                   # random crop + resize back\n",
    "            ch = int(round(h * r.uniform(c[\"min_crop_scale\"], 1.0)))\n",
    "            cw = int(round(w * r.uniform(c[\"min_crop_scale\"], 1.0)))\n",
    "            y, x = r.integers(0, h - ch + 1), r.integers(0, w - cw + 1)\n",
    "            img = bilinear_resize(img[y:y + ch, x:x + cw], h, w)\n",
    "        if r.random() < c[\"hflip\"]:\n",
    "            img = img[:, ::-1]\n",
    "        if r.random() < c[\"vflip\"]:\n",
    "            img = img[::-1]\n",
    "        if c[\"brightness\"]:\n",
    "            img = img * r.uniform(1 - c[\"brightness\"], 1 + c[\"brightness\"])\n",
    "        if c[\"contrast\"]:\n",
    "            m = img.mean()\n",
    "            img = (img - m) * r.uniform(1 - c[\"contrast\"], 1 + c[\"contrast\"]) + m\n",
    "        if c[\"saturation\"]:\n",
    "            gray = (img @ _LUMA)[..., None]\n",
    "            img = (img - gray) * r.uniform(1 - c[\"saturation\"], 1 + c[\"saturation\"]) + gray\n",
    "        return np.clip(img, 0.0, 1.0).astype(np.float32)\n",
    "\n",
    "    def batch(self, imgs):\n",
    "        return np.stack([self(im) for im in imgs])\n",
    "\n",
    "\n",
    "demo_aug = Augmenter(CONFIG[\"augment\"], np.random.default_rng(0))\n",
    "sample = images[tr_idx[0]]\n",
    "fig, axes = plt.subplots(3, 2, figsize=(10, 3.4))\n",
    "for k, ax in enumerate(axes.flat):\n",
    "    ax.imshow(sample if k == 0 else demo_aug(sample))\n",
    "    ax.set_title(\"original\" if k == 0 else f\"augmented #{k}\", loc=\"left\", fontsize=9, color=INK)\n",
    "    ax.set_xticks([]); ax.set_yticks([]); ax.grid(False)\n",
    "plt.tight_layout(); plt.show()"
   ]
