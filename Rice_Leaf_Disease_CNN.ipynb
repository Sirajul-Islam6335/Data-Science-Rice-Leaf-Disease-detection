    "IMAGE_EXTENSIONS = {\".jpg\", \".jpeg\", \".png\", \".bmp\", \".tif\", \".tiff\", \".webp\"}\n",
    "\n",
    "def scan_directory(root):\n",
    "    \"\"\"Expect root/<class_name>/<images>. Class indices follow sorted folder names.\"\"\"\n",
    "    root = Path(root)\n",
    "    class_dirs = sorted(d for d in root.iterdir() if d.is_dir() and not d.name.startswith(\".\"))\n",
    "    paths, labels = [], []\n",
    "    for idx, d in enumerate(class_dirs):\n",
    "        files = sorted(f for f in d.rglob(\"*\") if f.suffix.lower() in IMAGE_EXTENSIONS)\n",
    "        paths += [str(f) for f in files]\n",
    "        labels += [idx] * len(files)\n",
    "    return paths, np.array(labels, dtype=np.int64), [d.name for d in class_dirs]\n",
    "\n",
    "paths, labels, CLASS_NAMES = scan_directory(CONFIG[\"data_dir\"])\n",
    "K = len(CLASS_NAMES)\n",
    "print(f\"{len(paths)} images, {K} classes\")\n",
    "for i, name in enumerate(CLASS_NAMES):\n",
