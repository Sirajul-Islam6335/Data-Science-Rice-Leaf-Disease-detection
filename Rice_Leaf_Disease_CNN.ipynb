   "cell_type": "code",
   "execution_count": 14,
   "id": "efa8875e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_proba(model, x, batch_size=32, tta=False):\n",
    "    model.eval()\n",
    "    out = []\n",
    "    for i in range(0, len(x), batch_size):\n",
    "        xb = x[i:i + batch_size]\n",
    "        p = softmax(model(xb).astype(np.float64))\n",
    "        if tta:\n",
    "            p += softmax(model(np.ascontiguousarray(xb[..., ::-1])).astype(np.float64))     # horizontal flip\n",
    "            p += softmax(model(np.ascontiguousarray(xb[:, :, ::-1, :])).astype(np.float64))  # vertical flip\n",
    "            p /= 3\n",
    "        out.append(p)\n",
    "    return np.concatenate(out)\n",
    "\n",
    "\n",
    "def evaluate_predictions(y_true, probs, class_names):\n",
    "    y_true, y_pred, k = np.asarray(y_true), probs.argmax(axis=1), len(class_names)\n",
    "    cm = np.zeros((k, k), dtype=np.int64)\n",
    "    np.add.at(cm, (y_true, y_pred), 1)                       # cm[true, predicted]\n",
    "    tp = np.diag(cm).astype(float)\n",
    "    precision = np.divide(tp, cm.sum(0), out=np.zeros(k), where=cm.sum(0) > 0)\n",
    "    recall = np.divide(tp, cm.sum(1), out=np.zeros(k), where=cm.sum(1) > 0)\n",
    "    f1 = np.divide(2 * precision * recall, precision + recall, out=np.zeros(k), where=(precision + recall) > 0)\n",
    "    return dict(accuracy=float((y_pred == y_true).mean()), macro_f1=float(f1.mean()),\n",
    "                log_loss=float(-np.log(probs[np.arange(len(y_true)), y_true] + 1e-12).mean()),\n",
    "                precision=precision, recall=recall, f1=f1, support=cm.sum(1), confusion_matrix=cm, n=len(y_true))\n",
    "\n",
    "\n",
    "def classification_report(m, class_names):\n",
    "    w = max(map(len, class_names)) + 2\n",
    "    lines = [f\"{'':<{w}}{'precision':>10}{'recall':>10}{'f1-score':>10}{'support':>10}\", \"\"]\n",
    "    for i, n in enumerate(class_names):\n",
    "        lines.append(f\"{n:<{w}}{m['precision'][i]:>10.3f}{m['recall'][i]:>10.3f}{m['f1'][i]:>10.3f}{m['support'][i]:>10d}\")\n",
    "    lines += [\"\", f\"{'accuracy':<{w}}{'':>20}{m['accuracy']:>10.3f}{m['n']:>10d}\",\n",
    "              f\"{'macro avg':<{w}}{m['precision'].mean():>10.3f}{m['recall'].mean():>10.3f}{m['macro_f1']:>10.3f}{m['n']:>10d}\"]\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "def fit(train_images, train_labels, val_images, val_labels, cfg, verbose=True):\n",
    "    rng = np.random.default_rng(cfg[\"seed\"])\n",
    "    model = build_rice_leaf_net(K, cfg[\"channels\"], cfg[\"kernel_size\"], cfg[\"dropout\"], rng=rng)\n",
    "    augmenter = Augmenter(cfg[\"augment\"], rng) if cfg[\"augment\"][\"enabled\"] else None\n",
    "    mean, std = channel_stats(train_images)                 # training statistics only\n",
    "    x_val = to_model_input(val_images, mean, std)\n",
    "\n",
    "    opt = AdamW(model, lr=cfg[\"lr\"], weight_decay=cfg[\"weight_decay\"])\n",
    "    n, bs = len(train_images), min(cfg[\"batch_size\"], len(train_images))\n",
    "    steps = max(1, n // bs)\n",
    "    total, warmup = cfg[\"epochs\"] * steps, cfg[\"warmup_epochs\"] * steps\n",
    "    best = dict(val_loss=np.inf, epoch=0, state=model.state_dict())\n",
    "    history, step, bad = [], 0, 0\n",
    "\n",
    "    for epoch in range(1, cfg[\"epochs\"] + 1):\n",
    "        t0 = time.perf_counter(); model.train()\n",
    "        perm = rng.permutation(n)\n",
    "        losses, correct = [], 0\n",
    "        for b in range(steps):\n",
    "            idx = perm[b * bs:(b + 1) * bs]\n",
    "            imgs = augmenter.batch(train_images[idx]) if augmenter else train_images[idx]\n",
    "            x, y = to_model_input(imgs, mean, std), train_labels[idx]\n",
    "            opt.lr = warmup_cosine(step, total, warmup, cfg[\"lr\"], cfg[\"min_lr\"])\n",
    "            logits = model(x)                                        # forward\n",
    "            loss, dlogits = softmax_cross_entropy(logits, y, cfg[\"label_smoothing\"])\n",
    "            model.backward(dlogits)                                  # backward\n",
    "            clip_grad_norm(model, cfg[\"grad_clip\"])\n",
    "            opt.step()                                               # update\n",
    "            losses.append(loss); correct += int((logits.argmax(1) == y).sum()); step += 1\n",
    "\n",
    "        vm = evaluate_predictions(val_labels, predict_proba(model, x_val), CLASS_NAMES)\n",
    "        rec = dict(epoch=epoch, lr=opt.lr, train_loss=float(np.mean(losses)), train_acc=correct / (steps * bs),\n",
    "                   val_loss=vm[\"log_loss\"], val_acc=vm[\"accuracy\"], val_f1=vm[\"macro_f1\"])\n",
    "        history.append(rec)\n",
    "        improved = rec[\"val_loss\"] < best[\"val_loss\"] - 1e-4\n",
    "        if improved:\n",
    "            best, bad = dict(val_loss=rec[\"val_loss\"], epoch=epoch, state=model.state_dict()), 0\n",
    "        else:\n",
    "            bad += 1\n",
    "        if verbose:\n",
    "            print(f\"epoch {epoch:>3} | lr {rec['lr']:.2e} | train loss {rec['train_loss']:.4f} acc {rec['train_acc']:.3f} \"\n",
    "                  f\"| val loss {rec['val_loss']:.4f} acc {rec['val_acc']:.3f} | {time.perf_counter() - t0:.1f}s{'  *' if improved else ''}\")\n",
    "        if bad >= cfg[\"patience\"]:\n",
    "            if verbose: print(f\"Early stopping: no validation-loss improvement for {cfg['patience']} epochs.\")\n",
    "            break\n",
    "\n",
    "    model.load_state_dict(best[\"state\"]); model.eval()\n",
    "    if verbose: print(f\"Restored best weights from epoch {best['epoch']} (val loss {best['val_loss']:.4f}).\")\n",
    "    return model, mean, std, best[\"epoch\"], history"
   ]
  },
