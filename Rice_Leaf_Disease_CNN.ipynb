    "class Sequential:\n",
    "    def __init__(self, layers):\n",
    "        self.layers = layers\n",
    "        layers[0].skip_input_grad = True\n",
    "\n",
    "    def train(self):\n",
    "        for l in self.layers: l.training = True\n",
    "        return self\n",
    "\n",
    "    def eval(self):\n",
    "        for l in self.layers: l.training = False\n",
    "        return self\n",
    "\n",
    "    def __call__(self, x):\n",
    "        for l in self.layers: x = l.forward(x)\n",
    "        return x\n",
    "\n",
    "    def backward(self, dout):\n",
    "        for l in reversed(self.layers):\n",
    "            dout = l.backward(dout)\n",
    "            if dout is None: break\n",
    "\n",
    "    def parameters(self):\n",
    "        for l in self.layers:\n",
    "            for name in l.params:\n",
    "                yield l, name, name not in l.no_decay()\n",
    "\n",
    "    def num_params(self): return sum(l.num_params() for l in self.layers)\n",
    "\n",
    "    def state_dict(self):\n",
    "        return {f\"{i}.{k}\": v.copy() for i, l in enumerate(self.layers) for k, v in {**l.params, **l.buffers()}.items()}\n",
    "\n",
    "    def load_state_dict(self, state):\n",
    "        for i, l in enumerate(self.layers):\n",
    "            for k, v in {**l.params, **l.buffers()}.items():\n",
    "                v[...] = state[f\"{i}.{k}\"]\n",
    "\n",
    "    def summary(self, input_shape):\n",
    "        rows, s = [], tuple(input_shape)\n",
    "        for i, l in enumerate(self.layers):\n",
    "            s = l.output_shape(s)\n",
    "            rows.append(f\"{i:>2}  {l!r:<32}{str(s):<18}{l.num_params():>9,}\")\n",
    "        line = \"-\" * 61\n",
    "        return \"\\n\".join([line, f\"    {'Layer':<32}{'Output (C,H,W)':<18}{'Params':>9}\", line, *rows, line,\n",
    "                          f\"Total trainable parameters: {self.num_params():,}\", line])\n",
    "\n",
    "\n",
    "class AdamW:\n",
    "    def __init__(self, model, lr=1e-3, betas=(0.9, 0.999), eps=1e-8, weight_decay=1e-4):\n",
    "        self.refs = list(model.parameters())\n",
    "        self.lr, (self.b1, self.b2), self.eps, self.wd, self.t = lr, betas, eps, weight_decay, 0\n",
    "        self.m = [np.zeros_like(l.params[n]) for l, n, _ in self.refs]\n",
    "        self.v = [np.zeros_like(l.params[n]) for l, n, _ in self.refs]\n",
    "\n",
    "    def step(self):\n",
    "        self.t += 1\n",
    "        bc1, bc2 = 1 - self.b1 ** self.t, 1 - self.b2 ** self.t\n",
    "        for (l, n, decay), m, v in zip(self.refs, self.m, self.v):\n",
    "            p, g = l.params[n], l.grads[n]\n",
    "            m *= self.b1; m += (1 - self.b1) * g\n",
    "            v *= self.b2; v += (1 - self.b2) * g * g\n",
    "            if decay and self.wd:\n",
    "                p -= self.lr * self.wd * p                          # decoupled weight decay\n",
    "            p -= self.lr * (m / bc1) / (np.sqrt(v / bc2) + self.eps)\n",
    "\n",
    "\n",
    "def warmup_cosine(step, total, warmup, base_lr, min_lr=0.0):\n",
    "    if warmup > 0 and step < warmup:\n",
    "        return base_lr * (step + 1) / warmup\n",
    "    progress = min(max((step - warmup) / max(1, total - warmup), 0.0), 1.0)\n",
    "    return min_lr + 0.5 * (base_lr - min_lr) * (1 + math.cos(math.pi * progress))\n",
    "\n",
    "\n",
    "def clip_grad_norm(model, max_norm):\n",
    "    grads = [l.grads[n] for l, n, _ in model.parameters()]\n",
    "    total = float(np.sqrt(sum(float((g.astype(np.float64) ** 2).sum()) for g in grads)))\n",
    "    if max_norm and total > max_norm:\n",
    "        for g in grads: g *= max_norm / (total + 1e-12)\n",
    "    return total\n",
    "\n",
    "\n",
    "def build_rice_leaf_net(num_classes, channels=(16, 32, 64, 128), k=3, dropout=0.3, rng=None):\n",
    "    \"\"\"[Conv3x3 -> BN -> ReLU -> MaxPool] x len(channels) -> GAP -> Dropout -> Dense.\"\"\"\n",
    "    rng = rng or np.random.default_rng()\n",
    "    layers, c_in = [], 3\n",
    "    for c_out in channels:\n",
    "        layers += [Conv2D(c_in, c_out, k, bias=False, rng=rng), BatchNorm2D(c_out), ReLU(), MaxPool2D(2)]\n",
    "        c_in = c_out\n",
    "    layers += [GlobalAvgPool2D(), Dropout(dropout, rng=rng), Dense(c_in, num_classes, rng=rng)]\n",
    "    return Sequential(layers)"
   ]
